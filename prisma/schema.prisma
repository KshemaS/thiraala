// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  status      String    @default("active")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Collection {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  status      String    @default("active")
  featured    Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("collections")
}

model Product {
  id               String      @id @default(cuid())
  sku              String      @unique
  name             String
  subtitle         String?
  slug             String      @unique
  price            String
  priceValue       Int
  mrp              Int?
  rating           Float?
  ratingCount      Int?
  selectedColor    String?
  categoryName     String
  categoryId       String?
  category         Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collectionName   String?
  collectionId     String?
  collection       Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  stock            Int         @default(0)
  fabric           String?
  sareeFabric      String?
  color            String?
  pattern          String?
  border           String?
  blouse           String?
  occasion         String?
  sareeLength      String?     @default("5.5 metres")
  blouseLength     String?     @default("0.8 metres")
  careInstructions String?     @db.Text
  highlights       String?     @db.Text
  description      String?
  foldedImg        String?
  wornImg          String?
  altFolded        String?
  altWorn          String?
  status           String      @default("active")
  featured         Boolean     @default(false)
  isNewArrival     Boolean     @default(false)
  variants         ProductVariant[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("products")
}

/// A colour variant of a saree. Its own SKU, stock and photos; price/MRP
/// fall back to the parent product when null.
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String   @unique
  colorHex   String?
  priceValue Int?
  mrp        Int?
  stock      Int      @default(0)
  foldedImg  String?  @db.Text
  wornImg    String?  @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

/// Failed sign-in attempts per key (network address, or account + address),
/// used to lock out password guessing. See lib/auth/loginThrottle.ts.
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?

  @@map("login_throttles")
}

/// Named counters that must never hand out the same number twice
/// (e.g. "order" for THR-#### order numbers). See lib/counters.ts.
model Counter {
  name  String @id
  value Int

  @@map("counters")
}

/// Delivery charge per zone, editable in the dashboard. Which pincodes belong
/// to which zone is defined in lib/delivery.ts.
model DeliveryRate {
  zone          String   @id
  firstItemFee  Int
  extraItemFee  Int
  updatedAt     DateTime @updatedAt

  @@map("delivery_rates")
}

model HeroBanner {
  id        String   @id @default(cuid())
  imageKey  String   @unique
  imageUrl  String   @db.Text
  title     String?
  subtitle  String?
  link      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_banners")
}

model EditorialPhoto {
  id        String   @id @default(cuid())
  title     String
  url       String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("editorial_photos")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String?
  email        String   @unique
  passwordHash String?
  phone        String?
  role         String   @default("customer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model WishlistItem {
  id         String   @id @default(cuid())
  userId     String?
  productId  String
  name       String
  price      String
  foldedImg  String?  @db.Text
  wornImg    String?  @db.Text
  category   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("wishlist_items")
}

model Order {
  id                String      @id @default(cuid())
  humanId           String      @unique
  userId            String?
  customerName      String
  phone             String
  email             String?
  address           String
  houseOrFlat       String?
  street            String?
  city              String?
  district          String?
  state             String?
  pincode           String?
  total             Int
  subtotal          Int?
  deliveryFee       Int         @default(0)
  discount          Int         @default(0)
  paymentMethod     String      @default("Razorpay")
  paymentStatus     String      @default("Pending")
  status            String      @default("Pending")
  trackingNumber    String?
  courierName       String?
  notes             String?
  trackingTimeline  Json
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?
  /// True while this order holds stock (reserved at checkout, released on
  /// cancel / failed or abandoned payment). See lib/stock.ts.
  stockReserved     Boolean     @default(false)
  /// When the current stock hold started (unpaid holds expire after 30 min).
  stockReservedAt   DateTime?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  sku           String?
  name          String
  price         String
  priceValue    Int      @default(0)
  quantity      Int      @default(1)
  foldedImg     String?  @db.Text
  wornImg       String?  @db.Text
  category      String?
  selectedColor String?
  variantId     String?
  createdAt     DateTime @default(now())

  @@map("order_items")
}


